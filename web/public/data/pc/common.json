] seconds."]}]},{"id":59,"name":"ling random dialogue","trigger":0,"switchId":1,"commands":[{"code":122,"params":[22,22,0,2,1,5]},{"code":111,"params":[1,22,0,1,0]},{"code":101,"indent":1,"params":["@niko Pancakes are MY favorite food,\\> \\@niko_speak but what's yours?"]},{"code":101,"indent":1,"params":["@ling_hm Good question!\\>\\n\\@ling I'm not sure if I have one..."]},{"code":101,"indent":1,"params":["@ling_smile ...because it changes all the time!"]},{"code":411},{"code":111,"indent":1,"params":[1,22,0,2,0]},{"code":101,"indent":2,"params":["@ling Have you ever had steamed buns, Niko?"]},{"code":101,"indent":2,"params":["@ling_smile I've been making them a lot lately!"]},{"code":101,"indent":2,"params":["@niko_speak I've only heard of them!\\>\\n\\@niko5 Is it like bread?"]},{"code":101,"indent":2,"params":["@ling Kinda! But most of them have things inside."]},{"code":101,"indent":2,"params":["@niko2 Bread has things inside it too!"]},{"code":101,"indent":2,"params":["@niko_83c Like flour."]},{"code":411,"indent":1},{"code":111,"indent":2,"params":[1,22,0,3,0]},{"code":101,"indent":3,"params":["@ling_hm Sometimes I like to mix sugar in my water before I drink it."]},{"code":101,"indent":3,"params":["@niko_83c I do that with syrup and milk!"]},{"code":411,"indent":2},{"code":111,"indent":3,"params":[1,22,0,4,0]},{"code":101,"indent":4,"params":["@ling_oh I gotta admit, I had trouble finding hazelnut flour... \\>\\@ling_smile So I just made my own!"]},{"code":101,"indent":4,"params":["@niko_speak Oh, that's what mama does too!"]},{"code":101,"indent":4,"params":["@niko5 She uses a motor and pesto for it."]},{"code":101,"indent":4,"params":["@proto1b [Mortar and pestle.]"]},{"code":101,"indent":4,"params":["@niko_eyeclosed ...I knew that!"]},{"code":101,"indent":4,"params":["@ling_smile I just use a food processor!"]},{"code":101,"indent":4,"params":["@ling_hm You think it would work with almond flour too?"]},{"code":101,"indent":4,"params":["@niko_speak Probably!"]},{"code":101,"indent":4,"params":["@niko_eyeclosed But I like hazelnuts!"]},{"code":411,"indent":3},{"code":101,"indent":4,"params":["@niko I know fire is dangerous, but I like looking at it!"]},{"code":101,"indent":4,"params":["@ling_smile I know!"]},{"code":101,"indent":4,"params":["@ling Did you know that you can start a fire with just sunlight and a magnifying glass?"]},{"code":101,"indent":4,"params":["@niko_pancakes REALLY??"]},{"code":101,"indent":4,"params":["@ling_smile Yup!"]},{"code":101,"indent":4,"params":["@ling But don't try it on your own, okay?"]},{"code":101,"indent":4,"params":["@niko_eyeclosed Of course not!"]},{"code":101,"indent":4,"params":["@niko5 (But for some reason, all of a sudden I wish I still had the sun...)"]},{"code":101,"indent":4,"params":["@proto2 [I'm surrounded by lunatics.]"]},{"code":122,"params":[22,22,0,0,0]}]},{"id":60,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":61,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":62,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":63,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":64,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":65,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":66,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":67,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":68,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":69,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":70,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":71,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":72,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":73,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":74,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":75,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":76,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":77,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":78,"name":"","trigger":0,"switchId":1,"commands":[]},{"id":79